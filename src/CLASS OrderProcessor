CLASS OrderProcessor
 
    FUNCTION ProcessOrder(order, paymentType)
 
        IF order.items.count == 0 THEN

            THROW Error("Order has no items")

        END IF
 
        IF paymentType == "CreditCard" THEN

            gateway = NEW CreditCardGateway()

            gateway.Charge(order.total)

        ELSE IF paymentType == "PayPal" THEN

            gateway = NEW PayPalGateway()    

            gateway.Charge(order.total)

        ELSE

            THROW Error("Unsupported payment type")

        END IF
 
        emailClient = NEW SmtpClient("smtp.company.com")

        emailClient.Send(

            from: "orders@company.com",

            to: order.customerEmail,

            subject: "Order Confirmation",

            body: "Your order #" + order.id + " was processed."

        )
 
        AppendToFile("log.txt", Now() + ": Order " + order.id + " processed")
 
    END FUNCTION
 
END CLASS
 