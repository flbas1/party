import { useEffect, useState } from 'react'
import type { ReactNode } from 'react'
import { parse } from 'yaml'
import './App.css'

type Config = Record<string, any>

type Party = {
  id: string
  configUrl: string
}

type RenderContext = {
  loading: boolean
  onOption: (option: Config) => void
}

type ComponentRenderer = (
  node: Config,
  context: RenderContext,
  key: string | number,
) => ReactNode

function TextComponent({ node }: { node: Config }) {
  return <p>{node.content ?? node.text ?? ''}</p>
}

function CardComponent({
  node,
  context,
}: {
  node: Config
  context: RenderContext
}) {
  return (
    <section className="card">
      {node.title && <h2>{node.title}</h2>}
      {node.text && <p>{node.text}</p>}

      {node.options?.map((option: Config, index: number) => {
        const supported = option.capability === 'backend.directory-scan'

        return (
          <button
            key={option.label ?? index}
            disabled={context.loading || !supported}
            onClick={() => context.onOption(option)}
            title={
              supported
                ? option.description
                : 'This option is not implemented yet.'
            }
          >
            {option.label ?? 'Option'}
            {option.description && <small>{option.description}</small>}
            {!supported && <small>Not implemented yet</small>}
          </button>
        )
      })}
    </section>
  )
}

function LayoutComponent({
  node,
  context,
  direction,
}: {
  node: Config
  context: RenderContext
  direction: 'vertical' | 'horizontal'
}) {
  return (
    <div className={`layout ${direction}`}>
      {node.children?.map((child: Config, index: number) =>
        renderComponent(child, context, `${direction}-${index}`),
      )}
    </div>
  )
}

function UnsupportedComponent({ node }: { node: Config }) {
  return (
    <section className="card unsupported">
      <h2>Unsupported component</h2>
      <p>
        This configuration requests a component the app doesn't recognize:
        {' '}
        <code>{String(node.type ?? '(missing type)')}</code>
      </p>
    </section>
  )
}

const componentRegistry: Record<string, ComponentRenderer> = {
  text: (node, _context, key) => (
    <div key={key}>
      <TextComponent node={node} />
    </div>
  ),

  card: (node, context, key) => (
    <div key={key}>
      <CardComponent node={node} context={context} />
    </div>
  ),

  vertical: (node, context, key) => (
    <div key={key}>
      <LayoutComponent
        node={node}
        context={context}
        direction="vertical"
      />
    </div>
  ),

  horizontal: (node, context, key) => (
    <div key={key}>
      <LayoutComponent
        node={node}
        context={context}
        direction="horizontal"
      />
    </div>
  ),
}

function renderComponent(
  node: Config,
  context: RenderContext,
  key: string | number,
): ReactNode {
  if (!node || typeof node !== 'object') {
    return null
  }

  const type = typeof node.type === 'string' ? node.type : ''
  const renderer = componentRegistry[type]

  if (!renderer) {
    return <div key={key}><UnsupportedComponent node={node} /></div>
  }

  return renderer(node, context, key)
}

async function loadYaml(url: string): Promise<Config> {
  const response = await fetch(url)

  if (!response.ok) {
    throw new Error(`Could not load ${url}: HTTP ${response.status}`)
  }

  return parse(await response.text()) as Config
}

function App() {
  const [config, setConfig] = useState<Config | null>(null)
  const [partyId, setPartyId] = useState<string | null>(null)
  const [parties, setParties] = useState<Party[]>([])
  const [loading, setLoading] = useState(true)
  const [message, setMessage] = useState('')

  useEffect(() => {
    loadYaml('/bootstrap.yml')
      .then(setConfig)
      .catch(error => setMessage(String(error)))
      .finally(() => setLoading(false))
  }, [])

  async function selectOption(option: Config) {
    if (option.capability !== 'backend.directory-scan') {
      setMessage('This source is not implemented yet.')
      return
    }

    setMessage('')
    setLoading(true)

    try {
      const response = await fetch('/api/capabilities/directory-scan')

      if (!response.ok) {
        throw new Error(`Party discovery failed: HTTP ${response.status}`)
      }

      const discovered = (await response.json()) as Party[]
      setParties(discovered)

      if (discovered.length === 0) {
        setMessage('No party configurations found under partytime/.')
      }
    } catch (error) {
      setMessage(error instanceof Error ? error.message : String(error))
    } finally {
      setLoading(false)
    }
  }

  async function selectParty(party: Party) {
    setLoading(true)
    setMessage('')

    try {
      const partyConfig = await loadYaml(party.configUrl)
      setConfig(partyConfig)
      setPartyId(party.id)
    } catch (error) {
      setMessage(error instanceof Error ? error.message : String(error))
    } finally {
      setLoading(false)
    }
  }

  async function returnToBootstrap() {
    setLoading(true)
    setMessage('')
    setPartyId(null)
    setParties([])

    try {
      setConfig(await loadYaml('/bootstrap.yml'))
    } catch (error) {
      setMessage(error instanceof Error ? error.message : String(error))
    } finally {
      setLoading(false)
    }
  }

  const context: RenderContext = {
    loading,
    onOption: selectOption,
  }

  const isBootstrap = config?.id === 'bootstrap'
  const title = config?.title ?? config?.app?.name ?? 'PipBoy'
  const nodes: Config[] = config?.components ?? config?.layout?.children ?? []

  if (!config && loading) {
    return <main><p>Loading PipBoy...</p></main>
  }

  if (!config) {
    return (
      <main>
        <h1>PipBoy</h1>
        <p role="alert">{message || 'Configuration could not be loaded.'}</p>
        <button onClick={returnToBootstrap}>Retry</button>
      </main>
    )
  }

  return (
    <main>
      <header>
        <h1>{title}</h1>
        {partyId && (
          <button className="back" onClick={returnToBootstrap}>
            Back to party selection
          </button>
        )}
      </header>

      {isBootstrap && parties.length > 0 && (
        <section className="card">
          <h2>Available Parties</h2>
          {parties.map(party => (
            <button
              key={party.id}
              disabled={loading}
              onClick={() => selectParty(party)}
            >
              {party.id}
            </button>
          ))}
        </section>
      )}

      {nodes.map((node, index) =>
        renderComponent(node, context, index),
      )}

      {loading && <p>Loading...</p>}
      {message && <p role="status">{message}</p>}
    </main>
  )
}

export default App
